<Window x:Class="Pikvew.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:browser="clr-namespace:Pikvew.App.Browser"
        xmlns:controls="clr-namespace:Pikvew.App.Controls"
        Title="{Binding Title}" Width="1100" Height="750"
        MinWidth="480" MinHeight="320" AllowDrop="True"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="OnKeyDown" PreviewMouseDown="OnMouseDown" PreviewTextInput="OnBrowserTextInput"
        Drop="OnDrop" DragOver="OnDragOver">
  <Window.Resources>
    <HierarchicalDataTemplate DataType="{x:Type browser:DirectoryNode}" ItemsSource="{Binding Children}">
      <controls:RenameLabel Text="{Binding Name}" IsDirectory="True" IsCurrent="{Binding IsSelected}" RenameRequested="OnRenameRequested" ToolTip="{Binding Error}" Margin="2,4" />
    </HierarchicalDataTemplate>
    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
      <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><controls:DirectoryTreePanel /></ItemsPanelTemplate></Setter.Value></Setter>
      <EventSetter Event="Selected" Handler="OnTreeItemSelected" />
      <EventSetter Event="Loaded" Handler="OnTreeItemLoaded" />
    </Style>
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style x:Key="HistoryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="Margin" Value="3,0" /><Setter Property="Padding" Value="0" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Circle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="15"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <ContextMenu x:Key="FileMenu" Opened="OnFileMenuOpened">
      <MenuItem Header="Copy image" Click="OnCopyImage" />
      <MenuItem Header="Copy file(s)" Click="OnCopyFiles" />
      <MenuItem Header="Copy path(s)" Click="OnCopyPaths" />
      <Separator />
      <MenuItem Header="Copy to folder…" Click="OnCopyTo" />
      <MenuItem Header="Move to folder…" Click="OnMoveTo" />
      <MenuItem Header="Delete" InputGestureText="Del" Click="OnDelete" />
      <Separator />
      <MenuItem Header="Open" Click="OnOpen" />
      <MenuItem Header="Open with…" Click="OnOpenWith" />
    </ContextMenu>
  </Window.Resources>
  <Grid>
    <Grid x:Name="BrowserRoot" PreviewMouseWheel="OnBrowserWheel">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <DockPanel Margin="10,7">
        <Button x:Name="UpButton" DockPanel.Dock="Left" Click="OnUp" ToolTip="Parent folder (Alt+Up)" Width="32" Height="32" Padding="0" Margin="0,0,7,0" AutomationProperties.Name="Parent folder">
          <Path Data="M2,9L9,2L16,9 M9,2V18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="15" Height="17" Stretch="Uniform" />
        </Button>
        <Button x:Name="BackButton" DockPanel.Dock="Left" Click="OnBack" ToolTip="Back (Alt+Left)" Style="{StaticResource HistoryButton}" AutomationProperties.Name="Back"><Path Data="M11,2L4,9L11,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="8" Height="14" Stretch="Uniform" /></Button>
        <Button x:Name="ForwardButton" DockPanel.Dock="Left" Click="OnForward" ToolTip="Forward (Alt+Right)" Style="{StaticResource HistoryButton}" AutomationProperties.Name="Forward"><Path Data="M4,2L11,9L4,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="8" Height="14" Stretch="Uniform" /></Button>
        <Button DockPanel.Dock="Right" Content="File associations…" Click="OnAssociations" Margin="12,0,0,0" Padding="9,4" />
        <CheckBox DockPanel.Dock="Left" Content="Supported formats only" IsChecked="{Binding Browser.SupportedOnly}"
                  VerticalAlignment="Center" Margin="0,0,12,0" />
        <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Browser.SortOptions}" SelectedItem="{Binding Browser.Sort}"
                  Width="145" VerticalAlignment="Center" />
        <Slider x:Name="ThumbnailSlider" DockPanel.Dock="Right" Minimum="64" Maximum="640" Width="160" Margin="12,0,0,0"
                Value="{Binding Browser.ThumbnailSize}" VerticalAlignment="Center" />
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="12,0">
          <ItemsControl ItemsSource="{Binding Browser.Breadcrumbs}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type browser:BreadcrumbPart}">
              <StackPanel Orientation="Horizontal"><Button Content="{Binding Name}" Click="OnBreadcrumbClick" Padding="6,4" BorderThickness="0" Background="Transparent" /><TextBlock Text="›" VerticalAlignment="Center" Opacity="0.5" Margin="3,0" /></StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="TreeColumn" Width="240" MinWidth="100" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TreeView x:Name="FolderTree" ItemsSource="{Binding Browser.Roots}"
                  SelectedItemChanged="OnDirectorySelected"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.ScrollUnit="Pixel">
          <TreeView.Style><Style TargetType="TreeView"><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /></Trigger></Style.Triggers></Style></TreeView.Style>
          <TreeView.ItemsPanel><ItemsPanelTemplate><controls:DirectoryTreePanel /></ItemsPanelTemplate></TreeView.ItemsPanel>
        </TreeView>
        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="{DynamicResource SurfaceBrush}" Cursor="SizeWE">
          <GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Border Background="{TemplateBinding Background}"><Border Width="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Center" /></Border></ControlTemplate></GridSplitter.Template>
        </GridSplitter>
        <ListBox x:Name="Files" Grid.Column="2" ItemsSource="{Binding Browser.Files}"
                 SelectionMode="Extended" Background="Transparent"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 MouseDoubleClick="OnFilesDoubleClick" SelectionChanged="OnFileSelectionChanged"
                 PreviewMouseRightButtonDown="OnFilesRightClick" ContextMenu="{StaticResource FileMenu}">
          <ListBox.Style><Style TargetType="ListBox"><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="Transparent" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /></Trigger></Style.Triggers></Style></ListBox.Style>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><controls:ThumbnailPanel TileSize="{Binding Browser.ThumbnailSize}" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="5" /><Setter Property="Margin" Value="3" />
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Selection" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter TargetName="Selection" Property="BorderBrush" Value="#668FC0" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Setter.Value></Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type browser:FileItem}">
              <Grid ToolTip="{Binding Path}">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="22" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                <Border Background="{DynamicResource EditorBrush}" CornerRadius="4">
                  <Grid>
                    <TextBlock Text="{Binding Kind}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                    <controls:ThumbnailImage Stretch="Uniform" />
                    <controls:FolderIcon Stretch="Uniform" Margin="12">
                      <controls:FolderIcon.Style><Style TargetType="controls:FolderIcon"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsDirectory}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></controls:FolderIcon.Style>
                    </controls:FolderIcon>
                    <Grid>
                      <Grid.Style>
                        <Style TargetType="Grid">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers><DataTrigger Binding="{Binding IsUnsupported}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                      </Grid.Style>
                      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <Button Click="OnOpen" PreviewMouseLeftButtonDown="OnExternalOpenPress" ToolTip="Open with the default app (Enter)" Padding="4">
                        <StackPanel>
                          <controls:AssociatedAppIcon FilePath="{Binding Path}" Width="32" Height="32" Margin="0,0,0,5" />
                          <TextBlock Text="Open" HorizontalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Row="1" Content="Open with…" Click="OnUnsupportedTileOpenWith" PreviewMouseLeftButtonDown="OnExternalOpenPress" Margin="0,4,0,0" Padding="4" />
                    </Grid>
                  </Grid>
                </Border>
                <controls:RenameLabel Grid.Row="1" Text="{Binding Name}" IsDirectory="{Binding IsDirectory}" IsCurrent="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" RenameRequested="OnRenameRequested" Margin="2,3,2,0" />
                <TextBlock Grid.Row="2" Text="{Binding Kind}" FontSize="10" Opacity="0.65" Margin="2,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>
    <Grid x:Name="ViewerRoot" Background="Black" Visibility="Collapsed" MouseMove="OnViewerMouseMove" ContextMenu="{StaticResource FileMenu}">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <controls:ImageViewport x:Name="ImageCanvas" MouseWheel="OnViewerWheel"
                              MouseDown="OnViewerClick" ContextMenu="{StaticResource FileMenu}" />
      <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600" Margin="24">
        <TextBlock Text="{Binding Message}" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" />
        <StackPanel x:Name="UnsupportedActions" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,16,0,0">
          <Button Click="OnOpen" PreviewMouseLeftButtonDown="OnExternalOpenPress" ToolTip="Open with the default app (Enter)" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal"><controls:AssociatedAppIcon FilePath="{Binding CurrentPath}" Width="24" Height="24" Margin="0,0,8,0" /><TextBlock Text="Open" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button x:Name="UnsupportedOpenWith" Content="Open with…" Click="OnOpenWith" />
        </StackPanel>
      </StackPanel>
      <Border x:Name="ViewerToolbar" Grid.Row="1" Panel.ZIndex="1" Background="#EB161616" Padding="12,8">
        <StackPanel>
          <Grid x:Name="PlaybackPanel" Visibility="{Binding Playback.IsAnimated, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="OnPreviousFrame" ToolTip="Previous frame (,)" AutomationProperties.Name="Previous frame" Style="{StaticResource ToolbarButton}">
              <Path Data="M2,1V19 M17,2L5,10L17,18Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" />
            </Button>
            <Button Grid.Column="1" Click="OnPlayPause" ToolTip="Play / pause (Space)" AutomationProperties.Name="{Binding Playback.PlayLabel}" Style="{StaticResource ToolbarButton}">
              <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform">
                <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M4,2L18,10L4,18Z" /><Style.Triggers>
                  <DataTrigger Binding="{Binding Playback.IsPlaying}" Value="True"><Setter Property="Data" Value="M3,2H8V18H3Z M12,2H17V18H12Z" /></DataTrigger>
                </Style.Triggers></Style></Path.Style>
              </Path>
            </Button>
            <Button Grid.Column="2" Click="OnNextFrame" ToolTip="Next frame (.)" AutomationProperties.Name="Next frame" Style="{StaticResource ToolbarButton}">
              <Path Data="M18,1V19 M3,2L15,10L3,18Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" />
            </Button>
            <Slider x:Name="SeekSlider" Grid.Column="3" Minimum="0" Maximum="{Binding Playback.Duration}"
                    ValueChanged="OnSeek" PreviewMouseLeftButtonDown="OnSeekStart" PreviewMouseLeftButtonUp="OnSeekEnd"
                    IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="12,0" />
            <TextBlock Grid.Column="4" Text="{Binding Playback.TimeLabel}" Foreground="White" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{Binding Notice}" ToolTip="{Binding Notice}" FontSize="11" Foreground="#D0D0D0" TextTrimming="CharacterEllipsis" Margin="3,0,3,6">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
              <DataTrigger Binding="{Binding Notice}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <DockPanel>
            <Button DockPanel.Dock="Left" Content="Browser" Click="OnShowBrowser" Style="{StaticResource ToolbarButton}" ToolTip="Enter / double-click" />
            <Button DockPanel.Dock="Left" Content="ⓘ" Click="OnInfo" Style="{StaticResource ToolbarButton}" ToolTip="Image information (I)" AutomationProperties.Name="Image information" />
            <Button DockPanel.Dock="Left" Click="OnRotateLeft" Style="{StaticResource ToolbarButton}" ToolTip="Rotate counterclockwise (Ctrl+Left)" AutomationProperties.Name="Rotate counterclockwise">
              <Path Data="M15,6 A7,7 0 1 0 17,12 M15,1 V6 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform"><Path.LayoutTransform><ScaleTransform ScaleX="-1" /></Path.LayoutTransform></Path>
            </Button>
            <Button DockPanel.Dock="Left" Click="OnRotateRight" Style="{StaticResource ToolbarButton}" ToolTip="Rotate clockwise (Ctrl+Right)" AutomationProperties.Name="Rotate clockwise">
              <Path Data="M15,6 A7,7 0 1 0 17,12 M15,1 V6 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
            </Button>
            <Button x:Name="FullscreenButton" DockPanel.Dock="Right" Click="OnFullscreen" Style="{StaticResource ToolbarButton}" ToolTip="Fullscreen (Ctrl+Enter / middle click)" AutomationProperties.Name="Fullscreen">
              <Path x:Name="FullscreenGlyph" Data="M1,7V1H7 M13,1H19V7 M19,13V19H13 M7,19H1V13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" />
            </Button>
            <ComboBox x:Name="Transparency" DockPanel.Dock="Right" Width="125" Margin="10,0"
                      SelectionChanged="OnTransparencyChanged" ToolTip="Transparency background">
              <ComboBoxItem Content="Black" /><ComboBoxItem Content="White" /><ComboBoxItem Content="Checkerboard" />
            </ComboBox>
            <TextBlock x:Name="ZoomLabel" DockPanel.Dock="Right" Foreground="White" VerticalAlignment="Center" Margin="12,0" />
            <TextBlock Text="{Binding Dimensions}" DockPanel.Dock="Right" Foreground="White" VerticalAlignment="Center" Margin="12,0" />
            <TextBlock Text="{Binding FileName}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0" />
          </DockPanel>
        </StackPanel>
      </Border>
      <Border x:Name="MetadataPanel" Grid.Row="0" HorizontalAlignment="Right" Width="380" MaxWidth="{Binding ActualWidth, ElementName=ViewerRoot}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed" Padding="12">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="×" Click="OnInfo" ToolTip="Hide image information (I)" Padding="8,2" />
            <CheckBox x:Name="InfoPin" DockPanel.Dock="Right" Content="Pin" Click="OnInfoPin" VerticalAlignment="Center" Margin="8,0" />
            <TextBlock Text="Image information" FontSize="16" VerticalAlignment="Center" />
          </DockPanel>
          <DataGrid x:Name="MetadataTable" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="None" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}" RowBackground="{DynamicResource EditorBrush}" BorderThickness="0" SelectionUnit="FullRow" ClipboardCopyMode="IncludeHeader" ToolTip="Copy selected rows (Ctrl+C)">
            <DataGrid.Resources>
              <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" /><Setter Property="Padding" Value="4,7" /></Style>
              <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="3" /></Style>
            </DataGrid.Resources>
            <DataGrid.Columns><DataGridTextColumn Header="Field" Binding="{Binding Name}" Width="135" /><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Padding" Value="3" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
