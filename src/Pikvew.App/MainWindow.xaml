<Window x:Class="Pikvew.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:browser="clr-namespace:Pikvew.App.Browser"
        xmlns:controls="clr-namespace:Pikvew.App.Controls"
        Title="{Binding Title}" Width="1100" Height="750"
        MinWidth="480" MinHeight="320" AllowDrop="True"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="OnKeyDown" PreviewMouseDown="OnMouseDown"
        Drop="OnDrop" DragOver="OnDragOver">
  <Window.Resources>
    <HierarchicalDataTemplate DataType="{x:Type browser:DirectoryNode}" ItemsSource="{Binding Children}">
      <TextBlock Text="{Binding Name}" ToolTip="{Binding Error}" Margin="2,4" />
    </HierarchicalDataTemplate>
    <Style TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
    </Style>
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <ContextMenu x:Key="FileMenu" Opened="OnFileMenuOpened">
      <MenuItem Header="Copy image" Click="OnCopyImage" />
      <MenuItem Header="Copy file(s)" Click="OnCopyFiles" />
      <MenuItem Header="Copy path(s)" Click="OnCopyPaths" />
      <Separator />
      <MenuItem Header="Copy to folder…" Click="OnCopyTo" />
      <MenuItem Header="Move to folder…" Click="OnMoveTo" />
      <MenuItem Header="Delete" InputGestureText="Del" Click="OnDelete" />
      <Separator />
      <MenuItem Header="Open with…" Click="OnOpenWith" />
    </ContextMenu>
  </Window.Resources>
  <Grid>
    <Grid x:Name="BrowserRoot">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <DockPanel Margin="8">
        <Button DockPanel.Dock="Left" Content="Up" Click="OnUp" Style="{StaticResource ToolbarButton}" />
        <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseFolder" Style="{StaticResource ToolbarButton}" />
        <TextBox x:Name="Address" Text="{Binding Browser.DirectoryPath, Mode=OneWay}"
                 KeyDown="OnAddressKeyDown" VerticalContentAlignment="Center" Margin="4,0" />
      </DockPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="TreeColumn" Width="240" MinWidth="100" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TreeView x:Name="FolderTree" ItemsSource="{Binding Browser.Roots}"
                  SelectedItemChanged="OnDirectorySelected" BorderThickness="0"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
        <ListBox x:Name="Files" Grid.Column="2" ItemsSource="{Binding Browser.Files}"
                 SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 MouseDoubleClick="OnFilesDoubleClick" SelectionChanged="OnFileSelectionChanged"
                 PreviewMouseRightButtonDown="OnFilesRightClick" ContextMenu="{StaticResource FileMenu}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><controls:ThumbnailPanel TileSize="{Binding Browser.ThumbnailSize}" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="5" /><Setter Property="Margin" Value="3" />
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Selection" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter TargetName="Selection" Property="BorderBrush" Value="#668FC0" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Setter.Value></Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ToolTip="{Binding Path}">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="22" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                <Border Background="#14000000" CornerRadius="4">
                  <Grid>
                    <TextBlock Text="{Binding Kind}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                    <controls:ThumbnailImage Stretch="Uniform" />
                    <Button Content="Open with…" Click="OnUnsupportedTileOpenWith" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers><DataTrigger Binding="{Binding Supported}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="2,3,2,0" />
                <TextBlock Grid.Row="2" Text="{Binding Kind}" FontSize="10" Opacity="0.65" Margin="2,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <DockPanel Grid.Row="2" Margin="10,7">
        <CheckBox DockPanel.Dock="Left" Content="Supported formats only" IsChecked="{Binding Browser.SupportedOnly}"
                  VerticalAlignment="Center" Margin="0,0,16,0" />
        <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Browser.SortOptions}" SelectedItem="{Binding Browser.Sort}"
                  Width="150" VerticalAlignment="Center" />
        <Slider DockPanel.Dock="Right" Minimum="64" Maximum="320" Width="150" Margin="16,0,0,0"
                Value="{Binding Browser.ThumbnailSize}" ToolTip="Thumbnail size" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Browser.Status}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Grid>
    <Grid x:Name="ViewerRoot" Background="Black" Visibility="Collapsed" MouseMove="OnViewerMouseMove">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <controls:ImageViewport x:Name="ImageCanvas" MouseWheel="OnViewerWheel"
                              MouseDown="OnViewerClick" ContextMenu="{StaticResource FileMenu}" />
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600" Margin="24">
        <TextBlock Text="{Binding Message}" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" />
        <Button x:Name="UnsupportedOpenWith" Content="Open with…" Click="OnOpenWith" Margin="0,16,0,0"
                HorizontalAlignment="Center" Visibility="Collapsed" />
      </StackPanel>
      <Border x:Name="ViewerToolbar" Grid.Row="1" Background="#EB161616" Padding="12,8">
        <StackPanel>
          <Grid x:Name="PlaybackPanel" Visibility="{Binding Playback.IsAnimated, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="|◀" Click="OnPreviousFrame" ToolTip="Previous frame (,)" Style="{StaticResource ToolbarButton}" />
            <Button Grid.Column="1" Content="{Binding Playback.PlayLabel}" Click="OnPlayPause" ToolTip="Play / pause (Space)" Style="{StaticResource ToolbarButton}" />
            <Button Grid.Column="2" Content="▶|" Click="OnNextFrame" ToolTip="Next frame (.)" Style="{StaticResource ToolbarButton}" />
            <Slider x:Name="SeekSlider" Grid.Column="3" Minimum="0" Maximum="{Binding Playback.Duration}"
                    ValueChanged="OnSeek" PreviewMouseLeftButtonDown="OnSeekStart" PreviewMouseLeftButtonUp="OnSeekEnd"
                    IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="12,0" />
            <TextBlock Grid.Column="4" Text="{Binding Playback.TimeLabel}" Foreground="White" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{Binding Notice}" ToolTip="{Binding Notice}" FontSize="11" Foreground="#D0D0D0" TextTrimming="CharacterEllipsis" Margin="3,0,3,6">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
              <DataTrigger Binding="{Binding Notice}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <DockPanel>
            <Button DockPanel.Dock="Left" Content="Browser" Click="OnShowBrowser" Style="{StaticResource ToolbarButton}" ToolTip="Enter / double-click" />
            <Button DockPanel.Dock="Right" Content="Fullscreen" Click="OnFullscreen" Style="{StaticResource ToolbarButton}" ToolTip="Ctrl+Enter / middle click" />
            <ComboBox x:Name="Transparency" DockPanel.Dock="Right" Width="125" Margin="10,0"
                      SelectionChanged="OnTransparencyChanged" ToolTip="Transparency background">
              <ComboBoxItem Content="Black" /><ComboBoxItem Content="White" /><ComboBoxItem Content="Checkerboard" />
            </ComboBox>
            <TextBlock x:Name="ZoomLabel" DockPanel.Dock="Right" Foreground="White" VerticalAlignment="Center" Margin="12,0" />
            <TextBlock Text="{Binding Dimensions}" DockPanel.Dock="Right" Foreground="White" VerticalAlignment="Center" Margin="12,0" />
            <TextBlock Text="{Binding FileName}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0" />
          </DockPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
